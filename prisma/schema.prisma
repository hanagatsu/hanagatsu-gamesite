datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  nickname     String
  role         String        @default("USER")
  balance      Float         @default(1000000)
  createdAt    DateTime      @default(now())
  stocks       UserStock[]
  lottoTickets LottoTicket[]
  orders       StockOrder[]
}

model UserStock {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String
  name      String
  quantity  Int      @default(0)
  avgPrice  Float    @default(0)
  updatedAt DateTime @updatedAt
}

model LottoTicket {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  round     Int
  numbers   String
  createdAt DateTime @default(now())
}

model StockOrder {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "BUY" | "SELL"
  code      String
  name      String
  quantity  Int
  isUs      Boolean  @default(false)
  status    String   @default("PENDING") // "PENDING" | "COMPLETED" | "CANCELLED"
  createdAt DateTime @default(now())
}